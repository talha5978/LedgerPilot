{
	"name": "LedgerPilot",
	"description": "An AI finance assistant for freelancers & small businesses who get paid via PayPal.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,css,scss}\"",
		"gen-types": "pnpm dlx supabase gen types --schema public > ./app/types/database.ts && prettier --write ./app/types/database.ts"
	},
	"lint-staged": {
		"**/*.{js,ts,tsx,jsx,json,md,css,scss}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@react-router/node": "^8.5.0",
		"@react-router/serve": "^8.5.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"husky": "^9.1.7",
		"isbot": "^5.1.36",
		"lint-staged": "^17.6.0",
		"lucide-react": "^1.60.0",
		"prettier": "^3.9.10",
		"radix-ui": "^1.8.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.0",
		"shadcn": "^4.22.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@react-router/dev": "^8.5.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3"
	},
	"author": {
		"name": "Muhammad Talha",
		"email": "muhammadtalha13457@gmail.com",
		"url": "https://github.com/talha5978/"
	}
}
